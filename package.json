{
  "name": "ps-agent",
  "version": "0.1.0",
  "description": "AI-assisted MongoDB deployment health check and monitoring agent",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ps-agent": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scan": "tsx src/cli/index.ts scan",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js"
  },
  "dependencies": {
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.60",
    "mongodb": "^6.12.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "optionalDependencies": {
    "@langchain/anthropic": "^0.3.14",
    "@langchain/langgraph-checkpoint-mongodb": "^0.0.6",
    "@langchain/ollama": "^0.2.3",
    "@langchain/openai": "^0.4.4",
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
