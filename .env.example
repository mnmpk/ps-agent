# Copy to .env and fill in. Shell env vars always override these.

# --- LLM provider (for --summarize and chat) ---
# One of: anthropic | openai | ollama
PS_AGENT_LLM_PROVIDER=ollama
PS_AGENT_LLM_MODEL=gemma4:latest
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Storage backend ---
# Set to store sources/scans/audit/chat-memory in MongoDB (else local files).
# PS_AGENT_MONGO_URI=mongodb+srv://user:pass@cluster.example.net/
# PS_AGENT_MONGO_DB=ps_agent
# PS_AGENT_DATA_DIR=~/.ps-agent        # file-store location (when no Mongo URI)

# --- Credential encryption at rest ---
# Passphrase for AES-256-GCM. If unset, a local secret.key (0600) is generated.
# PS_AGENT_SECRET_KEY=change-me

# --- Server ---
# PS_AGENT_PORT=4000
# PS_AGENT_SCHEDULE_SUMMARIZE=1        # run LLM narration on scheduled scans

# --- Atlas (for scan --atlas) ---
# GROUPID=
# PUBLICKEY=
# PRIVATEKEY=
